# Git
.git
.gitignore

# Dependencies (each Dockerfile installs its own)
node_modules
*/node_modules
*/*/node_modules

# Build artifacts (multi-stage Dockerfiles build from source)
# NOTE: mcp_backend/dist and packages/shared/dist are NOT excluded —
# Dockerfile.document-service copies them directly (no builder stage)
mcp_rada/dist
mcp_openreyestr/dist
lexwebapp/dist
lexwebapp/dist-staging

# Test files
tests
test_data
test-results
coverage
**/coverage
**/__tests__
**/*.test.ts
**/*.spec.ts
.nyc_output

# Environment files
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# IDE and OS
.vscode
.idea
.DS_Store
Thumbs.db

# Logs
*.log
mcp_backend/logs
**/*.log

# Legacy and docs (not needed for builds)
legacy
docs
examples
config

# Docker and deployment artifacts
deployment/backups
deployment/nginx/certs
deployment/hudoc-storage
deployment/hudoc-storage/**
deployment/hudoc-storage/pgdata

# Local data staging (pgdata dirs here are owned by the postgres uid inside
# containers, so packing them into the build context fails with EACCES).
# Nothing is tracked in git here and no Dockerfile copies from it.
data
data/**

# Subpackage lockfiles were deliberately removed from git (22c6ab3b) and the
# Dockerfiles fall back to `npm install` when they are absent. A developer
# machine that ran `npm install` locally leaves stale ones behind, and
# `COPY packages/shared/package-lock.json*` then drags them into the build,
# where `npm ci` rejects them as out of sync. Keep the context matching git.
# lexwebapp/ and platform/ locks ARE tracked and must stay.
/package-lock.json
packages/*/package-lock.json
mcp_backend/package-lock.json
mcp_rada/package-lock.json
mcp_openreyestr/package-lock.json

# Misc
*.md
!packages/shared/README.md
