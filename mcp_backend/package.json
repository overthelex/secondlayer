{
  "name": "secondlayer-mcp",
  "version": "1.0.13",
  "description": "SecondLayer MCP Backend — semantic legal analysis, court decisions, legislation",
  "main": "dist/index.js",
  "bin": {
    "secondlayer-mcp": "./bin/mcp-start.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:http": "ts-node-dev --respawn --transpile-only src/http-server.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "db:create": "bash scripts/create-db.sh",
    "migrate": "npm run build && node dist/migrations/migrate.js",
    "db:setup": "npm run db:create && npm run migrate",
    "process:docs": "npm run build && node dist/scripts/process-existing-documents.js",
    "process:docs:dev": "ts-node-dev --transpile-only scripts/process-existing-documents.ts",
    "migrate:legislation": "bash scripts/migrate-legislation-schema.sh",
    "seed:admin": "npm run build && node dist/scripts/seed-admin-user.js",
    "seed:test-account": "npm run build && node dist/scripts/seed-test-account.js",
    "seed:test-account:dev": "ts-node-dev --transpile-only src/scripts/seed-test-account.ts",
    "test:email": "npm run build && node dist/scripts/test-email.js",
    "test:email:dev": "ts-node-dev --transpile-only src/scripts/test-email.ts",
    "docs": "xdg-open docs/index.html || open docs/index.html || start docs/index.html",
    "docs:api": "xdg-open docs/api-explorer.html || open docs/api-explorer.html || start docs/api-explorer.html",
    "test": "jest --no-cache --verbose",
    "test:watch": "jest --watch --no-cache --verbose",
    "lint": "eslint src --ext .ts",
    "create-api-keys": "ts-node bin/create-api-keys.ts",
    "seed:matters": "npm run build && node dist/scripts/seed-matter-data.js",
    "seed:matters:dev": "ts-node-dev --transpile-only src/scripts/seed-matter-data.ts",
    "scrape:court": "npm run build && node dist/scripts/scrape-court-registry.js",
    "scrape:court:civil-property": "JUSTICE_KIND=Цивільне JUSTICE_KIND_ID=1 DOC_FORM=Рішення SEARCH_TEXT='визнати право власності нерухоме майно' MAX_DOCS=500 npm run scrape:court",
    "scrape:court:civil-vindication": "JUSTICE_KIND=Цивільне JUSTICE_KIND_ID=1 DOC_FORM=Рішення SEARCH_TEXT='витребувати майно чужого незаконного володіння' MAX_DOCS=500 npm run scrape:court",
    "scrape:court:civil-registration": "JUSTICE_KIND=Цивільне JUSTICE_KIND_ID=1 DOC_FORM=Рішення SEARCH_TEXT='скасувати державну реєстрацію права нерухоме' MAX_DOCS=500 npm run scrape:court",
    "scrape:court:civil-contracts": "JUSTICE_KIND=Цивільне JUSTICE_KIND_ID=1 DOC_FORM=Рішення SEARCH_TEXT='недійсність договору купівлі-продажу нерухомого майна' MAX_DOCS=500 npm run scrape:court",
    "backfill:reyestr": "npm run build && node dist/scripts/backfill-fulltext-reyestr.js",
    "compute:judge-analytics": "npx tsx src/scripts/compute-judge-analytics.ts",
    "backfill:tsv": "npx tsx src/scripts/backfill-tsv.ts",
    "test:integration": "jest --no-cache --verbose --testPathIgnorePatterns=/node_modules/ src/api/__tests__/sse src/api/__tests__/all-tools-integration.test.ts src/api/__tests__/smoke-test-all-tools.test.ts src/api/__tests__/get-case-documents-chain.test.ts src/api/__tests__/get-legal-advice-cpc-gpc.test.ts src/api/__tests__/search-legal-precedents.test.ts"
  },
  "keywords": [
    "mcp",
    "legal-tech",
    "court-decisions",
    "semantic-search",
    "ukraine"
  ],
  "author": "SecondLayer Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@aws-sdk/client-bedrock": "^3.1014.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1014.0",
    "@aws-sdk/client-s3": "^3.1005.0",
    "@aws-sdk/client-sqs": "^3.1005.0",
    "@google-cloud/vision": "^5.3.4",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@qdrant/js-client-rest": "^1.17.0",
    "@secondlayer/core-interfaces": "file:../packages/core-interfaces",
    "@secondlayer/shared": "file:../packages/shared",
    "@simplewebauthn/server": "^13.2.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "adm-zip": "^0.6.0",
    "axios": "^1.18.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.70.4",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "diff": "^4.0.4",
    "dotenv": "^17.3.1",
    "ethers": "^6.16.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "express-session": "^1.18.2",
    "google-auth-library": "^10.6.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.11.0",
    "minio": "^8.0.6",
    "multer": "^2.1.0",
    "neo4j-driver": "^5.28.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.1",
    "openai": "^6.27.0",
    "openid-client": "^5.7.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "~5.5.207",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "playwright": "^1.58.0",
    "prom-client": "^15.1.3",
    "redis": "^5.11.0",
    "sharp": "^0.35.0",
    "tar": "^7.5.11",
    "tweetnacl": "^1.0.3",
    "uuid": "^14.0.0",
    "winston": "^3.11.0",
    "word-extractor": "^1.0.4",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.17",
    "@types/diff": "^7.0.2",
    "@types/eventsource": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.4.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/pdfkit": "^0.17.5",
    "@types/pg": "^8.18.0",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^7.2.0",
    "@types/tar": "^7.0.87",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^10.0.2",
    "eventsource": "^4.1.0",
    "jest": "^30.3.0",
    "jest-util": "^30.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "overrides": {
    "fast-xml-parser": ">=5.5.6",
    "flatted": ">=3.4.0",
    "undici": ">=6.24.0",
    "hono": ">=4.12.7",
    "@tootallnate/once": ">=3.0.1"
  }
}
