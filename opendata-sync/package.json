{
  "name": "opendata-sync",
  "version": "1.0.0",
  "description": "Scheduled sync service for Ukrainian government open data sources",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/__tests__/config.test.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "run-once": "node dist/index.js --run-once"
  },
  "dependencies": {
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
